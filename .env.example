# ─────────────────────────────────────────────────────────────────────────────
# .env  –  Copy this file to .env and fill in real values BEFORE running Docker
# NEVER commit .env to source control (it is already in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL credentials
DB_NAME=college_attendance
DB_USER=attendance_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# CORS – the public-facing URL of your site (no trailing slash)
# Use your EC2 public IP or domain name, e.g. http://54.123.45.67
FRONTEND_ORIGINS=http://YOUR_EC2_PUBLIC_IP_OR_DOMAIN

